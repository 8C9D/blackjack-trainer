/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "types": ["vitest/globals"]
  },
  // `**/*.test.ts` is collected by the unit-test target (angular.json, resolved
  // against sourceRoot), so it has to be typechecked here too: a file the runner
  // executes and no tsconfig covers is the gap M1 names, with a second doorway.
  "include": ["src/**/*.d.ts", "src/**/*.spec.ts", "src/**/*.test.ts"]
}
